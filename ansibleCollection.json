{
   "customManagers":[
      {
         "customType":"regex",
         "managerFilePatterns":[
            "/^\\.zuul\\.yaml$/"
         ],
         "matchStrings":[
            "ansible_molecule_ansible_version: \\\"(?<currentValue>.*?)\\\""
         ],
         "depNameTemplate": "ansible",
         "datasourceTemplate":"pypi"
      }
   ],

   "packageRules":[
      {
         "matchFileNames": ["**/.zuul.yaml"],
         "groupName": "test-role"
      }
   ]
}
