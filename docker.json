{
   "customManagers":[
      {
         "customType":"regex",
         "managerFilePatterns":[
            "/Containerfile/"
         ],
         "matchStrings":[
            "'(?<depName>pip)==(?<currentValue>.*?)'"
         ],
         "datasourceTemplate":"pypi"
      },
      {
         "customType":"regex",
         "managerFilePatterns":[
            "/Containerfile/"
         ],
         "matchStrings":[
            "ARG VERSION=(?<currentValue>.*?)  # renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\n"
         ]
      }
   ]
}
